{
  "encoding": "OpenCV IMREAD_COLOR (EXIF applied by OpenCV default)",
  "color": "RGB",
  "fundus_crop": {
    "proxy_long_side": 512,
    "threshold_max_rgb_gt": 15,
    "morph_open_kernel": [
      5,
      5
    ],
    "min_mask_pixels": 100,
    "crop_then_square_pad": true
  },
  "resize_chain": [
    {
      "size": [
        640,
        640
      ],
      "interpolation": "OpenCV INTER_AREA"
    },
    {
      "size": [
        512,
        512
      ],
      "interpolation": "OpenCV INTER_AREA"
    }
  ],
  "input": {
    "name": "fundus_image",
    "shape": [
      "batch",
      3,
      512,
      512
    ],
    "dtype": "float32",
    "layout": "NCHW"
  },
  "normalization": {
    "mean": [
      0.485,
      0.456,
      0.406
    ],
    "std": [
      0.229,
      0.224,
      0.225
    ],
    "formula": "(uint8 - mean*255) / (std*255)"
  },
  "feature_normalization": "x/(l2_norm(x)+1e-12); fitted train-only StandardScaler in graph"
}